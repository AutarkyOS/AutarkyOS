[Unit]
# The GLaDOS pool, on a machine where this user is not root.
#
# Installed by hand from `pool/deploy/glados-pool.user.service`, with three
# changes made for *this* host and each written down below rather than left to
# be rediscovered by whoever finds this file.
#
# To stop it for good:   systemctl --user disable --now glados-pool
# To see what it is:     systemctl --user status glados-pool
# Everything it owns is under ~/.local (bin, state, this unit). It writes
# nothing else and reads nothing it did not create.
Description=GLaDOS multi-coin mining pool (user)
Documentation=https://github.com/IlumCI/GLaDOS/blob/main/design/pool.md
After=network-online.target

# **Restarts are not rate limited, and that is deliberate here.** This binds a
# WireGuard address, and at boot the interface may not exist yet -- so failing
# repeatedly for a minute is the expected path rather than a fault. With the
# default burst of five the unit would give up and sit failed, which looks
# exactly like a pool that is broken.
StartLimitIntervalSec=0

[Service]
Type=simple

# --- the three host-specific choices ---
#
# **Bound to the tunnel, not 0.0.0.0.** Port 3334 is not forwarded on this
# network, so listening on every interface would expose the pool to the host's
# LAN -- other people's devices -- and buy nothing, since nobody outside could
# reach it anyway. 10.66.66.1 is this machine's wg0 address. When the port is
# forwarded, this line becomes 0.0.0.0:3334 and nothing else changes.
#
# **--cpu-percent 25.** This is a shared machine: it serves Jellyfin, Immich,
# Samba and DNS on four threads of a 2012 i3. The per-connection rate limit
# never bounded the total -- 256 connections were unbounded in aggregate -- so
# this is the number that decides how much of somebody else's box a flood can
# take. Measured on this host, an 8 MiB yespower share costs 19 ms to validate.
#
# **Cheap algorithms only.** Both coins are local, so they mine nothing real
# until an upstream is configured; what this deployment is for is uptime and a
# share log. Given that, there is no reason to spend 19 ms a share on yespower
# validation on a machine somebody else is watching films on.
ExecStart=%h/.local/bin/glados-pool \
    --listen 10.66.66.1:3334 \
    --ledger %S/glados-pool/ledger.json \
    --cpu-percent 25 \
    --window 268435456 \
    btc:sha256d:24:bitcoin \
    ftc:neoscrypt:20:feathercoin

Restart=always
RestartSec=5s

StateDirectory=glados-pool

# --- limits, and these are enforced here ---
#
# The unit in the repository says to check rather than assume, because a user
# manager only applies these when the controllers are delegated to it. Checked
# on this host:
#
#     $ cat /sys/fs/cgroup/user.slice/user-1001.slice/cgroup.controllers
#     cpu memory pids
#
# So `cpu` and `memory` are both delegated and both of these bite. That is
# worth knowing precisely because the file warns it is often not true.
MemoryMax=64M
MemoryHigh=48M
CPUQuota=50%
TasksMax=512

# --- hardening a user manager will honour ---
#
# `PrivateTmp` is deliberately absent: in a user manager it needs unprivileged
# user namespaces, and where those are disabled the unit does not degrade, it
# fails to start. It would also buy nothing, since the daemon never opens /tmp.
NoNewPrivileges=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native

[Install]
WantedBy=default.target
