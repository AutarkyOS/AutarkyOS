// One element by symbol, or nothing.
//
// Case matters, because it is what tells `Co` (cobalt) from `CO` (carbon
// monoxide) and there is no way to be helpful about that without being wrong
// about one of them.
fn el(sym) {
  t = elements()
  i = 0
  while (i < len(t)) {
    e = get(t, i)
    if (e.sym == sym) { return e }
    i = i + 1
  }
  return
}

// The molar mass of one element in g/mol, or -1 for a symbol not carried.
fn mass(sym) {
  e = el(sym)
  if (!e) { return -1 }
  return e.mass
}

fn byz(z: int) {
  t = elements()
  i = 0
  while (i < len(t)) {
    e = get(t, i)
    if (e.z == z) { return e }
    i = i + 1
  }
  return
}

// --- reading a formula --------------------------------------------------

fn isupper(c): int {
  o = ord(c)
  return o >= 65 && o <= 90
}

fn islower(c): int {
  o = ord(c)
  return o >= 97 && o <= 122
}

fn isdigit(c): int {
  o = ord(c)
  return o >= 48 && o <= 57
}

// A subscript, or 1 when there is none. `H2O` has one after H and none after
// O, and the absent one is a 1 rather than an error.
fn pnum(f, i: int) {
  n = 0
  seen = 0
  while (i < len(f) && isdigit(get(f, i))) {
    n = n * 10 + (ord(get(f, i)) - 48)
    seen = 1
    i = i + 1
  }
  if (seen == 0) { return Parse(1, i) }
  return Parse(n, i)
}

// Where an element symbol ends: one capital, then any lowercase.
fn psym(f, i: int): int {
  if (i >= len(f)) { return i }
  if (!isupper(get(f, i))) { return i }
  i = i + 1
  while (i < len(f) && islower(get(f, i))) { i = i + 1 }
  return i
}

// One group, up to the end of the string or an unmatched `)`.
//
// Recursive, so `Ca(OH)2` and `K4[Fe(CN)6]` -- were brackets spelled with
// parentheses -- both work, and so does nesting. A mass of -1 is the refusal,
// which is safe because no group has a negative mass.
fn pgroup(f, i: int) {
  total = 0
  while (i < len(f)) {
    c = get(f, i)
    if (c == ")") { return Parse(total, i) }
    if (c == "(") {
      inner = pgroup(f, i + 1)
      if (inner.mass < 0) { return Parse(-1, len(f)) }
      // An unclosed group is refused rather than treated as if it ended at the
      // end of the string, which would silently accept `Ca(OH2`.
      if (inner.at >= len(f)) { return Parse(-1, len(f)) }
      n = pnum(f, inner.at + 1)
      total = total + inner.mass * n.mass
      i = n.at
    } else {
      e = psym(f, i)
      if (e == i) { return Parse(-1, len(f)) }
      m = mass(substr(f, i, e - i))
      if (m < 0) { return Parse(-1, len(f)) }
      n = pnum(f, e)
      total = total + m * n.mass
      i = n.at
    }
  }
  return Parse(total, i)
}

// The molar mass of a formula in g/mol, exactly, or -1 if it cannot be read.
//
// One refusal covers three failures on purpose -- an unknown element, an
// unbalanced parenthesis and a character that is not part of a formula -- and
// they are one because the caller's next move is the same for all three. What
// matters is that none of them is a *number*.
fn molar(f) {
  r = pgroup(f, 0)
  if (r.mass < 0) { return -1 }
  // A trailing `)` means the parentheses did not balance the other way.
  if (r.at != len(f)) { return -1 }
  return r.mass
}

// --- what a mass is for -------------------------------------------------

// Moles in a given mass of a compound. Named for the singular so it does not
// collide with `/lib/phys`'s `moles`, which takes a molar mass rather than a
// formula -- `use` is textual, so two libraries sharing a name means whichever
// was imported second wins with nothing said.
fn mole(grams, f) {
  m = molar(f)
  if (m < 0) { return -1 }
  return rat(grams, m)
}

fn gram(moles, f) {
  m = molar(f)
  if (m < 0) { return -1 }
  return moles * m
}

// What fraction of a compound's mass is one element, exactly.
//
// The fraction is the answer and the percentage is a reading of it: iron in
// haematite is 12410/17743, and `real` or `/lib/prob`'s `pct` is where that
// becomes 69.94.
fn fracmass(f, sym) {
  whole = molar(f)
  if (whole < 0) { return -1 }
  n = countof(f, sym)
  if (n < 0) { return -1 }
  return rat(n * mass(sym), whole)
}

// How many atoms of one element a formula contains, counting through groups.
// A second walk of the same shape as `pgroup`, summing subscripts instead of
// masses. Two walks rather than one returning both, because a group's
// multiplier applies to each differently and folding them together was harder
// to read than writing the loop twice.
fn countof(f, sym): int {
  if (mass(sym) < 0) { return -1 }
  return cgroup(f, 0, sym).mass
}

fn cgroup(f, i: int, sym) {
  total = 0
  while (i < len(f)) {
    c = get(f, i)
    if (c == ")") { return Parse(total, i) }
    if (c == "(") {
      inner = cgroup(f, i + 1, sym)
      if (inner.at >= len(f)) { return Parse(0, len(f)) }
      n = pnum(f, inner.at + 1)
      total = total + inner.mass * n.mass
      i = n.at
    } else {
      e = psym(f, i)
      if (e == i) { return Parse(0, len(f)) }
      n = pnum(f, e)
      if (substr(f, i, e - i) == sym) { total = total + n.mass }
      i = n.at
    }
  }
  return Parse(total, i)
}

// The limiting reagent of two, given how much of each there is and how many
// of each the equation calls for. Answers 0 for the first and 1 for the
// second, which is what a caller branches on.
//
// Exact, and that is the point: the comparison is between two fractions, and
// two reagents that are *exactly* stoichiometric compare equal here where in
// floating point one of them wins by a rounding error.
fn limiting(g1, f1, n1: int, g2, f2, n2: int): int {
  a = mole(g1, f1)
  b = mole(g2, f2)
  if (a < 0 || b < 0) { return -1 }
  if (rat(a, n1) <= rat(b, n2)) { return 0 }
  return 1
}
